{
  "manifest_version": 3,
  "name": "VPN Analyzer",
  "description": "Detects VPN-like behavior and displays IP intelligence.",
  "version": "1.0",

  "action": {
    "default_popup": "popup.html"
  },

  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },

  "permissions": ["storage"],

  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}
